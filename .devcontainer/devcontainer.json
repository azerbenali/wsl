{
  "name": "WSL: ROS 2 Jazzy + Gazebo Harmonic",
  "build": { "dockerfile": "Dockerfile" },
  // Gazebo and DDS use shared memory; Docker's 64 MB default is too small.
  "runArgs": ["--shm-size=2g"],
  "containerEnv": {
    "DISPLAY": ":1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "ROS_DOMAIN_ID": "42"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Desktop: Gazebo + RViz (open /vnc.html)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "start-desktop",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "ms-python.flake8",
        "xaver.clang-format",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
