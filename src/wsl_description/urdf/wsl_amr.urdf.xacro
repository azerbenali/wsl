<?xml version="1.0"?>
<!--
  WSL warehouse AMR: differential drive base, 3D LiDAR on a mast, forward RGB
  camera and an IMU.

  base_footprint lies on the ground plane directly below the drive axle centre,
  base_link is at axle height, so the robot rotates about the base_link z axis.
  All geometry follows REP-103 (x forward, y left, z up).

  Arguments only cover quantities that benchmark scenarios vary (sensor
  fidelity, odometry calibration error). Fixed geometry stays as properties.
-->
<robot name="wsl_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="lidar_rate_hz" default="10"/>
  <xacro:arg name="lidar_channels" default="16"/>
  <xacro:arg name="lidar_horizontal_samples" default="900"/>
  <xacro:arg name="camera_rate_hz" default="20"/>
  <xacro:arg name="imu_rate_hz" default="100"/>
  <!--
    Ratio between the wheel geometry DiffDrive assumes and the true geometry.
    1.0 is a perfectly calibrated robot. Values != 1 reproduce the systematic
    odometry errors (Borenstein's E_d / E_b) seen on real robots.
  -->
  <xacro:arg name="odom_wheel_radius_scale" default="1.0"/>
  <xacro:arg name="odom_wheel_separation_scale" default="1.0"/>
  <xacro:arg name="ground_truth" default="true"/>

  <xacro:include filename="$(find wsl_description)/urdf/inertial.xacro"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.44"/>
  <xacro:property name="wheel_mass" value="1.2"/>

  <xacro:property name="chassis_length" value="0.60"/>
  <xacro:property name="chassis_width" value="0.38"/>
  <xacro:property name="chassis_height" value="0.18"/>
  <xacro:property name="chassis_mass" value="28.0"/>
  <xacro:property name="chassis_clearance" value="0.05"/>
  <!-- Chassis centre relative to base_link (which sits at axle height). -->
  <xacro:property name="chassis_z" value="${chassis_clearance + chassis_height/2 - wheel_radius}"/>
  <xacro:property name="chassis_top_z" value="${chassis_z + chassis_height/2}"/>

  <xacro:property name="caster_radius" value="0.035"/>
  <xacro:property name="caster_x" value="0.24"/>
  <!--
    Casters are 1 mm short of the ground so the driven wheels always carry the
    load; with four rigid contacts the wheels could otherwise lose traction.
    The resulting pitch is atan(0.001 / 0.24) = 0.24 deg.
  -->
  <xacro:property name="caster_collision_radius" value="${caster_radius - 0.001}"/>

  <xacro:property name="lidar_x" value="0.15"/>
  <xacro:property name="lidar_height_above_ground" value="0.50"/>
  <xacro:property name="lidar_z" value="${lidar_height_above_ground - wheel_radius}"/>
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_length" value="0.07"/>
  <xacro:property name="lidar_mass" value="0.8"/>
  <xacro:property name="mast_radius" value="0.025"/>
  <xacro:property name="mast_length" value="${lidar_z - lidar_length/2 - chassis_top_z}"/>

  <xacro:property name="camera_x" value="${chassis_length/2 + 0.015}"/>
  <xacro:property name="camera_z" value="0.11"/>

  <material name="chassis_orange"><color rgba="0.93 0.45 0.10 1.0"/></material>
  <material name="dark_grey"><color rgba="0.15 0.15 0.15 1.0"/></material>
  <material name="sensor_black"><color rgba="0.05 0.05 0.05 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="chassis">
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis_orange"/>
    </visual>
    <collision name="chassis">
      <origin xyz="0 0 ${chassis_z}"/>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>

    <visual name="mast">
      <origin xyz="${lidar_x} 0 ${chassis_top_z + mast_length/2}"/>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision name="mast">
      <origin xyz="${lidar_x} 0 ${chassis_top_z + mast_length/2}"/>
      <geometry><cylinder radius="${mast_radius}" length="${mast_length}"/></geometry>
    </collision>

    <xacro:macro name="caster" params="name x">
      <visual name="${name}_caster">
        <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision name="${name}_caster">
        <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
        <geometry><sphere radius="${caster_collision_radius}"/></geometry>
      </collision>
    </xacro:macro>
    <xacro:caster name="front" x="${caster_x}"/>
    <xacro:caster name="rear" x="${-caster_x}"/>

    <!-- Mast and caster mass is folded into the chassis box. -->
    <xacro:box_inertial mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_z}"/>
    </xacro:box_inertial>
  </link>

  <!--
    Both wheel axes point along +y: positive joint velocity rolls the wheel
    towards +x. DiffDrive accounts for the mirrored mounting itself.
  -->
  <xacro:macro name="drive_wheel" params="side y">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" velocity="20"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_separation/2}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation/2}"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_length}"/></geometry>
    </collision>
    <xacro:cylinder_inertial mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_length}">
      <origin/>
    </xacro:cylinder_inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.10 0.03"/></geometry>
      <material name="sensor_black"/>
    </visual>
    <xacro:box_inertial mass="0.1" x="0.03" y="0.10" z="0.03">
      <origin/>
    </xacro:box_inertial>
  </link>

  <!-- REP-103 optical convention: z forward, x right, y down. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${chassis_z}"/>
  </joint>
  <link name="imu_link"/>

  <xacro:include filename="$(find wsl_description)/urdf/wsl_amr.gazebo.xacro"/>

</robot>
