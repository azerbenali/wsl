<?xml version="1.0"?>
<!--
  Gazebo Harmonic systems and sensors for the WSL AMR.

  Gazebo-side topics live under /wsl/. The ROS names are assigned only in the
  wsl_sim bridge configuration, so the mapping between the two transports is
  explicit and reviewable in one file.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="lidar_channels" value="$(arg lidar_channels)"/>
  <xacro:property name="lidar_horizontal_samples" value="$(arg lidar_horizontal_samples)"/>
  <!-- VLP-16-like vertical field of view: +/- 15 deg. -->
  <xacro:property name="lidar_vertical_half_fov" value="${15.0 * pi / 180.0}"/>

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <!-- Casters and chassis: frictionless so they never resist turning. -->
  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <!--
      DiffDrive integrates wheel joint positions, so /odom drifts with wheel
      slip and with the configured calibration error. It is genuine wheel
      odometry, not a copy of the model pose.
    -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation * $(arg odom_wheel_separation_scale)}</wheel_separation>
      <wheel_radius>${wheel_radius * $(arg odom_wheel_radius_scale)}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <topic>/wsl/cmd_vel</topic>
      <odom_topic>/wsl/odom</odom_topic>
      <tf_topic>/wsl/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/wsl/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <xacro:if value="$(arg ground_truth)">
    <!--
      Evaluation-only model pose. It is bridged to ROS solely by the benchmark
      bridge configuration and has no TF; nothing in the estimation pipeline
      can consume it by accident.
    -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>wsl_amr_ground_truth</robot_base_frame>
        <odom_topic>/wsl/ground_truth/odom</odom_topic>
        <tf_topic>/wsl/ground_truth/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:if>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/wsl/lidar</topic>
      <update_rate>$(arg lidar_rate_hz)</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <!-- max_angle excludes +pi so the first and last rays do not coincide. -->
          <horizontal>
            <samples>${lidar_horizontal_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2.0 * pi / lidar_horizontal_samples}</max_angle>
          </horizontal>
          <vertical>
            <samples>${lidar_channels}</samples>
            <resolution>1</resolution>
            <min_angle>${-lidar_vertical_half_fov}</min_angle>
            <max_angle>${lidar_vertical_half_fov}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <!--
      Gazebo cameras look along +x of the sensor pose (camera_link); the image
      is labelled with the optical frame because pixel data follows the
      optical convention.
    -->
    <sensor name="camera" type="camera">
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <topic>/wsl/camera/image</topic>
      <update_rate>$(arg camera_rate_hz)</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <camera_info_topic>/wsl/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>40.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <!--
      Noise from consumer MEMS datasheet densities sampled at 100 Hz
      (bandwidth ~50 Hz): gyro 0.014 deg/s/sqrt(Hz) -> 1.7e-3 rad/s,
      accelerometer 175 ug/sqrt(Hz) -> 1.2e-2 m/s^2.
    -->
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/wsl/imu</topic>
      <update_rate>$(arg imu_rate_hz)</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-3</stddev><bias_stddev>1e-5</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-3</stddev><bias_stddev>1e-5</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-3</stddev><bias_stddev>1e-5</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.2e-2</stddev><bias_stddev>1e-4</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.2e-2</stddev><bias_stddev>1e-4</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.2e-2</stddev><bias_stddev>1e-4</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
