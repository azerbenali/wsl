<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wsl_perception</name>
  <version>0.1.0</version>
  <description>3D LiDAR point-cloud pipeline for WSL: validation, range/ROI/voxel filtering, RANSAC ground removal and Euclidean obstacle clustering.</description>
  <maintainer email="azerbenali5017@gmail.com">Azer Ben Ali</maintainer>
  <license>Apache-2.0</license>
  <author>Azer Ben Ali</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>sensor_msgs</depend>
  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>pcl_conversions</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_updater</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
