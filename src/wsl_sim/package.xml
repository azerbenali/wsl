<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wsl_sim</name>
  <version>0.1.0</version>
  <description>WSL simulation and bring-up: Gazebo Harmonic warehouse world, robot spawning, ROS-Gazebo bridge configuration, RViz and the full-system launch.</description>
  <maintainer email="azerbenali5017@gmail.com">Azer Ben Ali</maintainer>
  <license>Apache-2.0</license>
  <author>Azer Ben Ali</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>wsl_description</exec_depend>
  <exec_depend>wsl_perception</exec_depend>
  <exec_depend>wsl_slam</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
